# Entorno de los tests de integración. Sin secretos: la base es desechable y
# vive en el mismo contenedor `co-pg` que la de desarrollo, con otro nombre.
# El sufijo `_test` no es cosmético: `tests/setup/db.ts` se niega a truncar
# una base cuya URL no lo tenga.
NODE_ENV=test
DATABASE_URL=postgresql://casaorigen:casaorigen@localhost:5435/casaorigen_test?schema=public
ADMIN_PASSWORD=test-admin-password
AUTH_SECRET=test-auth-secret-at-least-32-characters-long
LOG_LEVEL=silent
