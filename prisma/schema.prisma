// ---------------------------------------------------------------------------
//  Casa Origen — data model
//
//  Conventions
//  * Monetary values are stored as integers in the currency's smallest unit
//    (see `CURRENCY` in src/constants/money.ts). Integer arithmetic removes
//    floating-point drift and keeps every amount JSON-serialisable across the
//    server/client boundary.
//  * Every table that is read on a hot path carries a covering index.
//  * Snapshots (order lines) intentionally denormalise name/price so that a
//    later catalogue edit never rewrites history.
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
//  Enums
// ===========================================================================

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethodCode {
  CASH
  DEBIT
  CREDIT
  TRANSFER
}

enum ProductAvailability {
  AVAILABLE
  OUT_OF_STOCK
  SCHEDULED
}

enum VariantSelectionType {
  SINGLE
  MULTIPLE
}

enum DiscountType {
  PERCENTAGE
  FIXED
  /// A fixed price for a whole group of N matching units ("2 de 32 cm por
  /// $17.990"). `value` is the price of the bundle, not the discount: the
  /// engine derives the discount from what those units would have cost.
  BUNDLE_PRICE
}

enum PromotionScope {
  ALL
  CATEGORY
  PRODUCT
}

enum BannerPlacement {
  HERO
  MENU_TOP
  SIDEBAR
  CHECKOUT
}

// ===========================================================================
//  Customers
//  No accounts, no login — every order is a guest checkout. Admin access is
//  a single shared password (see src/lib/auth/admin-session.ts), not a user
//  table.
// ===========================================================================

model Customer {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String

  /// Scrypt hash (see `lib/security/password.ts`). Null for the rows the
  /// checkout upserts on a guest order: having ordered is not having an
  /// account, and a guest must never be able to "log in" as nobody.
  passwordHash String?

  notes      String?
  isBlocked  Boolean @default(false)
  orderCount Int     @default(0)
  totalSpent Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses CustomerAddress[]
  orders    Order[]

  @@unique([phone])
  /// Unique because it is the login identifier. Null stays repeatable in
  /// Postgres, so guest rows without an email are unaffected.
  @@unique([email])
  @@index([createdAt])
  @@index([totalSpent])
  @@map("customers")
}

model CustomerAddress {
  id        String  @id @default(cuid())
  label     String?
  street    String
  reference String?
  isDefault Boolean @default(false)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  communeId String
  commune   Commune @relation(fields: [communeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([communeId])
  @@map("customer_addresses")
}

/// A delivery zone. Named "commune" to match Chilean addressing.
model Commune {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  /// Delivery fee actually charged at checkout, in minor currency units.
  /// Kept as the single amount the totals pipeline adds up: the quoted range
  /// below is a display device, but an order still needs one number.
  deliveryFee  Int     @default(0)
  /// Quoted range shown before checkout. The real fee depends on the exact
  /// address inside the zone, so the storefront advertises a band and the
  /// operator confirms the final amount over WhatsApp. When min equals max
  /// the fee is flat and the UI shows a single figure.
  deliveryFeeMin Int   @default(0)
  deliveryFeeMax Int   @default(0)
  /// Minimum order subtotal required to deliver here.
  minOrder     Int     @default(0)
  /// Extra minutes added to the estimated delivery time.
  extraMinutes Int     @default(0)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses CustomerAddress[]
  orders    Order[]

  @@index([isActive, sortOrder])
  @@map("communes")
}

// ===========================================================================
//  Catalogue
// ===========================================================================

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  icon        String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  /// Self-relation implementing subcategories (one level is enforced in the
  /// service layer; the schema itself allows arbitrary depth).
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  promotions PromotionCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Tag {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  color     String  @default("#e2725b")
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductTag[]

  @@index([isActive])
  @@map("tags")
}

model Ingredient {
  id         String  @id @default(cuid())
  name       String  @unique
  slug       String  @unique
  /// Marks common allergens so the storefront can surface a warning.
  isAllergen Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductIngredient[]

  @@index([isActive])
  @@map("ingredients")
}

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  sku              String? @unique
  shortDescription String?
  description      String?
  image            String?

  /// Base price in minor currency units.
  price      Int
  /// Promotional price; when set and lower than `price` it becomes effective.
  offerPrice Int?

  isActive     Boolean             @default(true)
  isVisible    Boolean             @default(true)
  isFeatured   Boolean             @default(false)
  availability ProductAvailability @default(AVAILABLE)

  /// Estimated preparation time in minutes.
  prepMinutes Int     @default(15)
  allowNotes  Boolean @default(true)
  sortOrder   Int     @default(0)

  /// Denormalised counter maintained inside the order transaction; powers the
  /// "most sold" reports without scanning order_items.
  soldCount Int @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images        ProductImage[]
  tags          ProductTag[]
  ingredients   ProductIngredient[]
  variantGroups VariantGroup[]
  extras        ProductExtra[]
  orderItems    OrderItem[]
  promotions    PromotionProduct[]

  @@index([categoryId, isActive, sortOrder])
  @@index([isActive, isVisible, isFeatured])
  @@index([availability])
  @@index([soldCount])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model ProductIngredient {
  productId    String
  ingredientId String
  /// When true the customer may remove this ingredient at checkout.
  isRemovable  Boolean @default(true)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

/// A set of mutually related choices for a product ("Size", "Cooking point").
model VariantGroup {
  id            String               @id @default(cuid())
  name          String
  selectionType VariantSelectionType @default(SINGLE)
  isRequired    Boolean              @default(true)
  minSelect     Int                  @default(1)
  maxSelect     Int                  @default(1)
  sortOrder     Int                  @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options VariantOption[]

  @@index([productId, sortOrder])
  @@map("variant_groups")
}

model VariantOption {
  id          String  @id @default(cuid())
  name        String
  /// Signed delta applied to the product price, in minor currency units.
  priceDelta  Int     @default(0)
  /// Unit price charged for a **standard** add-on while this option is
  /// selected, in minor currency units. The carta prices toppings by pizza size
  /// and by tier, not by topping: $700 on a 24 cm and $1.200 on a 32 cm for the
  /// vegetable ones. `null` falls back to the extra's own catalogue price.
  extraPrice  Int?
  /// Same, for an add-on flagged `Extra.isPremium` ($1.000 / $1.500). `null`
  /// falls back to `extraPrice`, so a size that does not split by tier keeps
  /// charging one number for everything.
  extraPremiumPrice Int?
  isDefault   Boolean @default(false)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  groupId String
  group   VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItemVariants OrderItemVariant[]

  @@index([groupId, sortOrder])
  @@map("variant_options")
}

/// A globally reusable add-on ("Extra cheese"), attachable to many products.
model Extra {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  price       Int     @default(0)
  /// The carta splits add-ons into two tiers, "Vegetales" and "Premium", and
  /// charges each at its own pair of prices. The tier lives here and the two
  /// prices live on the size option (`VariantOption.extraPrice` /
  /// `extraPremiumPrice`), because what a topping costs depends on both.
  isPremium   Boolean @default(false)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   ProductExtra[]
  orderItems OrderItemExtra[]

  @@index([isActive, sortOrder])
  @@map("extras")
}

model ProductExtra {
  productId     String
  extraId       String
  /// Per-product override of the extra's catalogue price.
  priceOverride Int?
  maxQuantity   Int    @default(5)
  sortOrder     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  extra   Extra   @relation(fields: [extraId], references: [id], onDelete: Cascade)

  @@id([productId, extraId])
  @@index([extraId])
  @@map("product_extras")
}

// ===========================================================================
//  Promotions & coupons
// ===========================================================================

model Promotion {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String?
  discountType DiscountType
  /// Percentage points (0-100) or a fixed amount in minor currency units.
  value        Int
  scope        PromotionScope @default(ALL)
  /// Only applies once the cart subtotal reaches this amount.
  minSubtotal  Int            @default(0)
  /// Caps a percentage discount; null means uncapped.
  maxDiscount  Int?
  priority     Int            @default(0)
  isActive     Boolean        @default(true)
  startsAt     DateTime
  endsAt       DateTime?

  /// BUNDLE_PRICE only: how many matching units make one bundle.
  bundleSize         Int     @default(0)
  /// BUNDLE_PRICE only: the `VariantOption.name` every unit must carry
  /// ("32 cm"). Matched by name and not by id on purpose — each product owns
  /// its own size rows, so an id would only ever cover a single pizza.
  bundleVariantName  String?
  /// Storefront copy for the size the bundle is sold at ("32 cm").
  bundleSizeLabel    String?
  /// When true the landing renders the bundle builder above the menu.
  isFeatured         Boolean @default(false)
  /// Photo for the builder header and the landing card.
  image              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories PromotionCategory[]
  products   PromotionProduct[]
  orders     Order[]

  @@index([isActive, startsAt, endsAt])
  @@index([priority])
  @@map("promotions")
}

model PromotionCategory {
  promotionId String
  categoryId  String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
  @@map("promotion_categories")
}

model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  description      String?
  discountType     DiscountType
  value            Int
  minSubtotal      Int          @default(0)
  maxDiscount      Int?
  /// Total redemptions allowed; null means unlimited.
  usageLimit       Int?
  usageCount       Int          @default(0)
  /// Redemptions allowed per customer.
  perCustomerLimit Int          @default(1)
  /// When true the coupon also zeroes the delivery fee.
  freeDelivery     Boolean      @default(false)
  isActive         Boolean      @default(true)
  /// When true the code is advertised on the storefront. Private codes stay
  /// redeemable at checkout but are never listed.
  isPublic         Boolean      @default(false)
  startsAt         DateTime
  endsAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id             String  @id @default(cuid())
  couponId       String
  orderId        String  @unique
  customerId     String?
  discountAmount Int

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([customerId])
  @@map("coupon_redemptions")
}

// ===========================================================================
//  Orders
// ===========================================================================

model Order {
  id   String @id @default(cuid())
  /// Human-facing sequential-ish identifier shown to customers and staff.
  code String @unique

  status        OrderStatus   @default(NEW)
  type          OrderType     @default(DELIVERY)
  paymentStatus PaymentStatus @default(PENDING)

  // --- Customer snapshot -------------------------------------------------
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName  String
  lastName   String
  phone      String
  email      String?

  // --- Address snapshot --------------------------------------------------
  street      String?
  reference   String?
  communeId   String?
  commune     Commune? @relation(fields: [communeId], references: [id], onDelete: SetNull)
  communeName String?

  // --- Money (minor currency units) --------------------------------------
  subtotal      Int
  discountTotal Int  @default(0)
  deliveryFee   Int  @default(0)
  total         Int
  /// Amount the customer will pay with, when paying cash.
  cashGiven     Int?
  /// Change owed back to the customer.
  changeDue     Int?

  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  couponId    String?
  coupon      Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  notes              String?
  cancellationReason String?
  estimatedMinutes   Int?

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      OrderItem[]
  history    OrderStatusHistory[]
  redemption CouponRedemption?

  @@index([status, placedAt])
  @@index([customerId])
  @@index([placedAt])
  @@index([phone])
  @@index([paymentMethodId])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Nullable so deleting a product never destroys order history.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // --- Snapshot ----------------------------------------------------------
  name               String
  unitPrice          Int
  quantity           Int
  /// (unitPrice + modifiers) * quantity
  lineTotal          Int
  notes              String?
  /// Ingredients the customer asked to remove, stored as plain names.
  removedIngredients String[] @default([])

  createdAt DateTime @default(now())

  variants OrderItemVariant[]
  extras   OrderItemExtra[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemVariant {
  id String @id @default(cuid())

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  optionId String?
  option   VariantOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  groupName  String
  optionName String
  priceDelta Int    @default(0)

  @@index([orderItemId])
  @@map("order_item_variants")
}

model OrderItemExtra {
  id String @id @default(cuid())

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  extraId String?
  extra   Extra?  @relation(fields: [extraId], references: [id], onDelete: SetNull)

  name      String
  unitPrice Int
  quantity  Int    @default(1)

  @@index([orderItemId])
  @@map("order_item_extras")
}

model OrderStatusHistory {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ===========================================================================
//  Operations & configuration
// ===========================================================================

model PaymentMethod {
  id             String            @id @default(cuid())
  code           PaymentMethodCode @unique
  name           String
  description    String?
  /// Cash requires the "pays with / change" flow at checkout.
  requiresChange Boolean           @default(false)
  /// Bank details or instructions shown after selecting the method.
  instructions   String?
  isActive       Boolean           @default(true)
  sortOrder      Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, sortOrder])
  @@map("payment_methods")
}

model BusinessHour {
  id        String  @id @default(cuid())
  /// 0 = Sunday … 6 = Saturday (matches `Date#getDay`).
  dayOfWeek Int     @unique
  isClosed  Boolean @default(false)
  /// Minutes from midnight, so comparisons stay integer-only.
  opensAt   Int     @default(720)
  closesAt  Int     @default(1380)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_hours")
}

model Banner {
  id          String          @id @default(cuid())
  title       String
  subtitle    String?
  image       String
  mobileImage String?
  ctaLabel    String?
  ctaHref     String?
  placement   BannerPlacement @default(HERO)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  startsAt    DateTime?
  endsAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

/// Single-row table holding restaurant-wide configuration.
model RestaurantSettings {
  id String @id @default("singleton")

  name        String  @default("Casa Origen")
  tagline     String?
  description String?
  logo        String?
  favicon     String?

  email    String?
  phone    String?
  whatsapp String?
  address  String?

  instagramUrl String?
  facebookUrl  String?

  /// Master switch: when false the storefront accepts no new orders.
  acceptingOrders Boolean @default(true)
  closedMessage   String?
  /// Independent from `acceptingOrders` — lets the admin disable delivery
  /// (e.g. driver unavailable) while pickup keeps working.
  deliveryEnabled Boolean @default(true)

  /// Baseline delivery fee used when a commune has none of its own.
  defaultDeliveryFee Int @default(0)
  /// Cart subtotal above which delivery is free; 0 disables the rule.
  freeDeliveryFrom   Int @default(0)
  minOrderAmount     Int @default(0)
  defaultPrepMinutes Int @default(30)
  deliveryEtaMinutes Int @default(45)
  pickupEtaMinutes   Int @default(20)

  /// Percentage points, applied at the very end of the totals pipeline.
  taxRate     Int     @default(0)
  taxIncluded Boolean @default(true)

  seoTitle       String?
  seoDescription String?
  seoImage       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restaurant_settings")
}

/// Persistent counter used to generate short, human-readable order codes
/// without relying on a database sequence the app cannot introspect.
model Counter {
  key   String @id
  value Int    @default(0)

  updatedAt DateTime @updatedAt

  @@map("counters")
}
