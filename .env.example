# ---------------------------------------------------------------------------
# Casa Origen — environment template
# Copy to `.env` for local development and to `.env.production` on the VPS.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database --------------------------------------------------------------
POSTGRES_USER=casaorigen
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=casaorigen
POSTGRES_PORT=5432
DATABASE_URL=postgresql://casaorigen:change-me-strong-password@localhost:5432/casaorigen?schema=public&connection_limit=20&pool_timeout=20

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters-value
BETTER_AUTH_URL=http://localhost:3000

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug

# --- Security --------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# --- Seed ------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@casaorigen.cl
SEED_ADMIN_PASSWORD=Admin123!Change

# --- Public (inlined into the browser bundle) ------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Casa Origen
NEXT_PUBLIC_CURRENCY=CLP
NEXT_PUBLIC_LOCALE=es-CL
